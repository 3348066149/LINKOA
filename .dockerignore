# ---- 版本控制 ----
.git
.gitignore

# ---- 本地运行产物（构建/运行时自动生成，不进镜像）----
.venv
**/__pycache__
*.pyc
frontend/node_modules
frontend/dist
frontend/vite.config.js.timestamp-*.mjs

# ---- 数据（属于运行数据，用数据卷持久化，不写进镜像）----
backend/*.db
backend/uploads
data

# ---- 敏感配置（用环境变量 / 数据卷注入，不写进镜像）----
backend/.env

# ---- 与本项目运行无关的目录/大文件 ----
.workbuddy
artifacts
deliverables
*.pptx
