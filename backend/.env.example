# 数据库连接
# 说明：不配置 .env 时，系统默认就用项目根 data/ 的 SQLite（与 Docker 共用一套数据），零配置可用。
# SQLite（默认，统一数据目录 = 项目根 data/，相对 backend/ 的写法）：
# DB_URL=sqlite:///./../data/linkoa.db
# MySQL（PyMySQL 同步驱动）：
DB_URL=mysql+pymysql://root:your_password@localhost:3306/linkoa?charset=utf8mb4

# JWT 密钥（生产环境务必修改，长度建议 >= 32 字节）
JWT_SECRET=linkoa-dev-secret-0123456789abcdef-change-me

# JWT 过期时间（小时），默认 24
JWT_EXPIRE_HOURS=24

# 附件存储根目录（相对 backend/，指向项目根 data/uploads，与 Docker 共用）
UPLOAD_DIR=../data/uploads

# 前端开发地址（CORS 放行）
CORS_ORIGINS=http://localhost:5173
