# SQLite：统一数据目录 = 项目根 data/（相对 backend/ 用 ../ 指回项目根）。Docker 与本地共用同一份数据，
# 备份/搬家只拷项目根 data/ 一个文件夹即可
DB_URL=sqlite:///./../data/linkoa.db
JWT_SECRET=linkoa-dev-secret-0123456789abcdef-change-me
JWT_EXPIRE_HOURS=24
UPLOAD_DIR=../data/uploads
CORS_ORIGINS=http://localhost:5173

# AI 助手默认配置（首次启动写入 ai_config 表，之后以数据库为准，管理员面板可改）
AI_API_KEY=sk-4bb9e281fcba4c26af52f3e1fce57be2
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-v4-flash
