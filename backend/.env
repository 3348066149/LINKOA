# SQLite：相对路径写法，config.py 会自动转成 backend/ 目录下的绝对路径，
# 换机器/换用户名/从任意目录启动都不会找错文件（数据库随项目走）
DB_URL=sqlite:///./linkoa.db
JWT_SECRET=linkoa-dev-secret-0123456789abcdef-change-me
JWT_EXPIRE_HOURS=24
UPLOAD_DIR=uploads
CORS_ORIGINS=http://localhost:5173

# AI 助手默认配置（首次启动写入 ai_config 表，之后以数据库为准，管理员面板可改）
AI_API_KEY=sk-4bb9e281fcba4c26af52f3e1fce57be2
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-v4-flash
